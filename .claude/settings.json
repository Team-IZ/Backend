{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew tasks --quiet)",
      "Bash(./gradlew test)",
      "Bash(./gradlew check)",
      "Bash(./gradlew build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
